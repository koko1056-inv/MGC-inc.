# Resend API Key for contact form (get free key at https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address to receive contact form submissions
CONTACT_RECEIVER_EMAIL=kokomu.matsuo@mgc-global01.com

# Gemini API Key for image generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image

# Text model for the AI diagnosis endpoint (optional).
# Leave unset to auto-fallback: gemini-3.0-flash → 3-flash → flash-latest → 3.0-pro → 2.5-flash
# GEMINI_TEXT_MODEL=gemini-3.0-flash

# Backend Port (local dev only)
PORT=3001

# --- Supabase: AI診断リードの保存先 ---
# service_role キーはサーバー専用。絶対にフロントに出さない／コミットしない。
# 未設定でも診断は動作するが、リードは保存されずメール通知のみになる。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
