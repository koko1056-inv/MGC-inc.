{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path(.+)/",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/tiktok-callback",
      "destination": "/tiktok-callback.html"
    },
    {
      "source": "/tiktok-developers-site-verification=XTXhOKY6dU5oJbp1LOu746E3EvjUi3NU",
      "destination": "/tiktok-developers-site-verification=XTXhOKY6dU5oJbp1LOu746E3EvjUi3NU.html"
    },
    {
      "source": "/column",
      "destination": "/column/index.html"
    },
    {
      "source": "/column/",
      "destination": "/column/index.html"
    },
    {
      "source": "/column/:slug",
      "destination": "/column/:slug.html"
    },
    {
      "source": "/works",
      "destination": "/works.html"
    },
    {
      "source": "/training",
      "destination": "/training.html"
    },
    {
      "source": "/cases",
      "destination": "/cases.html"
    },
    {
      "source": "/mission",
      "destination": "/mission.html"
    },
    {
      "source": "/company",
      "destination": "/company.html"
    },
    {
      "source": "/career",
      "destination": "/career.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/service/:slug",
      "destination": "/service/:slug.html"
    },
    {
      "source": "/diagnosis",
      "destination": "/200.html"
    },
    {
      "source": "/contact/thanks",
      "destination": "/200.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
